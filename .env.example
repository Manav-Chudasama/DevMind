# ─── GitHub ───────────────────────────────────────────────────────────────────
# Personal access token — scopes: repo + admin:repo_hook (classic PAT)
GITHUB_TOKEN=ghp_...
# Random string — must match the webhook secret set on each registered GitHub repo
GITHUB_WEBHOOK_SECRET=change_me_to_a_long_random_string

# ─── LLM + Embeddings ─────────────────────────────────────────────────────────
# Used by: Coder/Planner/Reviewer (gpt-4o) + RAG indexer (text-embedding-3-small)
OPENAI_API_KEY=sk-...
# Embedding model. Changing this requires a matching vector(N) column in
# schema.sql and a full re-index — 1536 dims is text-embedding-3-small.
EMBEDDING_MODEL=text-embedding-3-small

# ─── Database ─────────────────────────────────────────────────────────────────
# Matches docker-compose postgres service credentials
DATABASE_URL=postgresql://admin:secret@localhost:5432/devmind

# ─── Redis ────────────────────────────────────────────────────────────────────
# Matches docker-compose redis service
REDIS_URL=redis://localhost:6379

# ─── API Config ───────────────────────────────────────────────────────────────
PORT=8080
# Publicly reachable URL of this API — used when registering GitHub webhooks.
# For local dev: run `ngrok http 8080` and paste the https URL here.
# For production: set to your deployed API's URL.
PUBLIC_URL=http://localhost:8080
# Directory where DevMind clones watched repos (relative to apps/api cwd)
REPOS_BASE_PATH=./repos

# ─── Worker Config ────────────────────────────────────────────────────────────
# Base URL of the worker's HTTP surface (/health, /search). The API proxies
# RAG search here so the embedder has exactly one implementation.
WORKER_BASE_URL=http://localhost:8081
# Port the worker binds that HTTP surface to
WORKER_HEALTH_PORT=8081
# Number of issues processed in parallel (BullMQ worker concurrency)
WORKER_CONCURRENCY=5
# Max Coder → Reviewer loop iterations before forcing PR
MAX_REVIEW_ITERATIONS=3
